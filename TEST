                }
            } else if (warehouseGroup.visible) {
                
                if (hoveredSBP) {
                    kardusGroup.children.forEach(k => {
                        if (k.userData.isKardus && k.userData.noSBP === hoveredSBP) {
                            k.userData.materialRef.color.setHex(k.userData.originalColor);
                            if (k.userData.isSearched) {
                                k.userData.materialRef.emissive.setHex(0xbf00ff); 
                            } else {
                                k.userData.materialRef.emissive.setHex(0x000000);
                            }
                        }
                    });
                    hoveredSBP = null;
                }
                
                if (hoveredFloor) {
                    hoveredFloor.userData.materialRef.color.setHex(hoveredFloor.userData.originalColor);
                    hoveredFloor = null;
                }

                const intersects = raycaster.intersectObjects(warehouseGroup.children, true);
                let isHoveringSomething = false;

                for(let i=0; i<intersects.length; i++) {
                    const obj = intersects[i].object;
                    
                    if (obj.userData.isKardus) {
                        document.body.style.cursor = 'pointer';
                        tooltip.style.display = 'block';
                        tooltip.innerHTML = obj.userData.tooltip;
                        
                        hoveredSBP = obj.userData.noSBP;
                        
                        kardusGroup.children.forEach(k => {
                            if (k.userData.isKardus && k.userData.noSBP === hoveredSBP) {
                                k.userData.materialRef.color.setHex(k.userData.hoverColor); 
                                if (!k.userData.isSearched) {
                                    k.userData.materialRef.emissive.setHex(k.userData.hoverColor);
                                    k.userData.materialRef.emissiveIntensity = 0.6;
                                }
                            }
                        });
                        
                        isHoveringSomething = true; break;
                    } else if (obj.userData.isFloor) {
                        document.body.style.cursor = 'pointer';
                        tooltip.style.display = 'block';
                        tooltip.innerHTML = `LANTAI ${obj.userData.id}`;
                        
                        obj.userData.materialRef.color.setHex(obj.userData.hoverColor); 
                        hoveredFloor = obj;
                        
                        isHoveringSomething = true; break;
                    } else if (obj.name === "PintuKeluar" || obj.parent?.name === "PintuKeluar") {
                        document.body.style.cursor = 'pointer';
                        tooltip.style.display = 'block';
                        tooltip.innerHTML = "KELUAR";
                        isHoveringSomething = true; break;
                    }
                }

                if(!isHoveringSomething) {
                    document.body.style.cursor = 'default'; tooltip.style.display = 'none';
                }
            }
        });

