                warehouseGroup.scale.set(0.4, 0.4, 0.4);
                
                // Menggeser ke kanan (X: 3.5) dan ke bawah (Y: -6)
                // Anda bisa sedikit mengubah angka 3.5 dan -6 ini nanti agar posisinya pas 100% di kotak pink Anda
                warehouseGroup.position.set(3.5, -6, 0); 
            }
        }

        function resetWarehouseForMobile() {
            if (window.innerWidth <= 768) {
                // Kembalikan ke ukuran normal (100%)
                warehouseGroup.scale.set(1, 1, 1);
                
                // Kembalikan ke posisi tengah (0)
                warehouseGroup.position.set(0, 0, 0);
            }
        }
        // --- FITUR UPLOAD FOTO ---
        const btnUploadFoto = document.getElementById('btn-upload-foto');
        const uploadPopup = document.getElementById('upload-popup');
        const closeUpload = document.getElementById('close-upload');
        const uploadSbpSelect = document.getElementById('upload-sbp-select');
        const formUpload = document.getElementById('form-upload-foto');

        // Buka Jendela Upload
        btnUploadFoto.addEventListener('click', () => {
            uploadSbpSelect.innerHTML = '<option value="">-- Pilih Nomor SBP --</option>';
            globalBHPData.forEach(item => {
                if (item["NO SBP"] && String(item["NO SBP"]).trim() !== "" && String(item["NO SBP"]).trim() !== "-") {
                    const opt = document.createElement('option');
                    opt.value = item["NO SBP"];
                    opt.textContent = `SBP-${item["NO SBP"]}`;
                    uploadSbpSelect.appendChild(opt);
                }
            });
            uploadPopup.classList.remove('hidden');
        });

        // Tutup Jendela
        closeUpload.addEventListener('click', () => {
            uploadPopup.classList.add('hidden');
            formUpload.reset();
        });

        // --- FUNGSI KOMPRESI GAMBAR (CANVAS) ---
        // Parameter: max 1200px lebar/tinggi, kualitas JPEG 70% (0.7)
        const compressImage = (file, maxSize = 1200, quality = 0.7) => {
            return new Promise((resolve, reject) => {
                if (!file) {
                    resolve(null);
                    return;
                }
                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = event => {
                    const img = new Image();
                    img.src = event.target.result;
                    img.onload = () => {
                        let width = img.width;
                        let height = img.height;

                        // Kalkulasi rasio ukuran baru
                        if (width > height) {
                            if (width > maxSize) {
                                height = Math.round(height *= maxSize / width);
                                width = maxSize;
                            }
                        } else {
                            if (height > maxSize) {
                                width = Math.round(width *= maxSize / height);
                                height = maxSize;
                            }
                        }

                        // Gambar ulang di Canvas dengan ukuran baru
                        const canvas = document.createElement('canvas');
                        canvas.width = width;
                        canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);

                        // Ekstrak kembali menjadi file
                        canvas.toBlob((blob) => {
                            const compressedFile = new File([blob], file.name, {
                                type: 'image/jpeg', // Selalu convert ke JPEG agar ringan
                                lastModified: Date.now()
                            });
                            resolve(compressedFile);
                        }, 'image/jpeg', quality);
                    };
                    img.onerror = error => reject(error);
                };
                reader.onerror = error => reject(error);
            });
        };

        // Eksekusi Submit Upload
        formUpload.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const noSbp = uploadSbpSelect.value;
            if(!noSbp) { alert("Pilih SBP terlebih dahulu!"); return; }

            let file1 = document.getElementById('input-foto-1').files[0];
            let file2 = document.getElementById('input-foto-2').files[0];

            const submitBtn = document.getElementById('btn-submit-upload');
            const originalBtnText = submitBtn.innerHTML;
            
            // Proses Kompresi Berjalan
            submitBtn.innerHTML = "MENGOMPRESI FOTO... ⏳";
            submitBtn.disabled = true;

            try {
                // Kompres foto sebelum diupload
                file1 = await compressImage(file1);
                file2 = await compressImage(file2);

                submitBtn.innerHTML = "MENGUNGGAH KE SERVER... ⏳";

                // --- API KEY IMGBB ---
                const imgbbAPIKey = "fd0e11468ff1dd3825db9efd957f077a"; 

                // Fungsi membuat nama acak (random) 10 karakter
                const generateRandomName = () => Math.random().toString(36).substring(2, 12);

                // Fungsi upload 1 file ke ImgBB
                const uploadToImgBB = async (file) => {
                    if (!file) return ""; 
                    const formData = new FormData();
                    
                    // Ekstensi dikunci ke .jpg karena sudah diconvert di fungsi compressImage
                    const randomFileName = `${generateRandomName()}.jpg`;
                    formData.append('image', file, randomFileName);
                    
                    const response = await fetch(`https://api.imgbb.com/1/upload?key=${imgbbAPIKey}`, {
                        method: 'POST',
                        body: formData
                    });
                    const data = await response.json();
                    if (data.success) {
                        return data.data.url;
                    } else {
                        throw new Error("Gagal upload ke Server");
                    }
                };

                // Upload kedua foto secara bersamaan (paralel)
                let [urlFoto1, urlFoto2] = await Promise.all([
                    uploadToImgBB(file1),
                    uploadToImgBB(file2)
                ]);

                if (!urlFoto1 && !urlFoto2) {
                    throw new Error("Gagal mengunggah foto. Periksa koneksi atau API Key Anda.");
                }

                // --- MODIFIKASI URL KHUSUS INDONESIA ---
                // Mengubah i.ibb.co menjadi i.ibb.co.com agar tidak diblokir
                if (urlFoto1) urlFoto1 = urlFoto1.replace('i.ibb.co', 'i.ibb.co.com');
                if (urlFoto2) urlFoto2 = urlFoto2.replace('i.ibb.co', 'i.ibb.co.com');

                submitBtn.innerHTML = "MENYIMPAN KE DATABASE... ⏳";

                // Paket data untuk Google Apps Script
                const payload = {
                    "NO SBP": noSbp,
                    "FOTO1": urlFoto1,
                    "FOTO2": urlFoto2
                };

                const gasURL = "https://script.google.com/macros/s/AKfycbyD8mEHenV_O6tZeSSRS996g9E2nHeZbWQQ0VduDserie8LW_6IeUjXsLejTHc3ypFm/exec"; 
                
                const gasResponse = await fetch(gasURL, {
                    method: "POST",
                    body: JSON.stringify(payload)
                });
                const gasResult = await gasResponse.json();
                
                if(gasResult.status === "success") {
                    alert("Berhasil! Foto telah dikompres, diupload, dan tersimpan di Database.");
                    uploadPopup.classList.add('hidden');
                    formUpload.reset();
                    enterWarehouse(); // Muat ulang data gudang
                } else {
                    alert("Gagal menyimpan ke database: " + gasResult.message);
                }
            } catch (error) {
                console.error(error);
                alert(error.message);
            } finally {
                submitBtn.innerHTML = originalBtnText;
                submitBtn.disabled = false;
            }
        });
        // --- FITUR EDIT STATUS ---
        const btnEditStatus = document.getElementById('btn-edit-status');
        const editPopup = document.getElementById('edit-popup');
        const closeEdit = document.getElementById('close-edit');
        const sbpSelect = document.getElementById('edit-sbp-select');
        const formEdit = document.getElementById('form-edit-status');

        // Buka Jendela Edit
        btnEditStatus.addEventListener('click', () => {
            // Isi dropdown SBP dengan data globalBHPData dari Spreadsheet
            sbpSelect.innerHTML = '<option value="">-- Pilih Nomor SBP --</option>';
            globalBHPData.forEach(item => {
                if (item["NO SBP"] && String(item["NO SBP"]).trim() !== "" && String(item["NO SBP"]).trim() !== "-") {
                    const opt = document.createElement('option');
                    opt.value = item["NO SBP"];
                    opt.textContent = `SBP-${item["NO SBP"]}`;
                    sbpSelect.appendChild(opt);
                }
            });
            editPopup.classList.remove('hidden');
        });

        // Tutup Jendela Edit
        closeEdit.addEventListener('click', () => {
            editPopup.classList.add('hidden');
            formEdit.reset();
        });

        // Auto-fill form ketika nomor SBP dipilih
        sbpSelect.addEventListener('change', (e) => {
            const selectedSBP = e.target.value;
            const match = globalBHPData.find(item => String(item["NO SBP"]) === selectedSBP);
            
            if (match) {
                document.getElementById('edit-lokasi').value = match["LOK PENYIMPANAN BHP"] || "";
                document.getElementById('edit-lhp').value = match["LHP"] || "";
                
                // Ambil data KEP lama. Jika ada /KBC..., pisahkan dan ambil angka depannya saja agar user mudah mengeditnya
                let kepBdn = match["KEP BDN"] ? String(match["KEP BDN"]) : "";
                let kepBmmn = match["KEP BMMN"] ? String(match["KEP BMMN"]) : "";
                
                if(kepBdn.includes("/")) kepBdn = kepBdn.split("/")[0];
                if(kepBmmn.includes("/")) kepBmmn = kepBmmn.split("/")[0];
                
                document.getElementById('edit-kep-bdn').value = kepBdn === "-" ? "" : kepBdn;
                document.getElementById('edit-kep-bmmn').value = kepBmmn === "-" ? "" : kepBmmn;
                
                // Set Dropdown Status
                const statusVal = match["STATUS"] || "-";
                const statusDropdown = document.getElementById('edit-status-dropdown');
                let found = Array.from(statusDropdown.options).some(opt => opt.value.toLowerCase() === statusVal.toLowerCase());
                
                if (found) {
                    Array.from(statusDropdown.options).forEach(opt => {
                        if (opt.value.toLowerCase() === statusVal.toLowerCase()) opt.selected = true;
                    });
                } else {
                    statusDropdown.value = "-";
                }
            }
        });

        // Eksekusi ketika tombol Simpan ditekan
        formEdit.addEventListener('submit', (e) => {
            e.preventDefault();
            
            const noSbp = sbpSelect.value;
            if(!noSbp) { alert("Pilih SBP terlebih dahulu!"); return; }

            const currentYear = new Date().getFullYear();
            let kepBdnInput = document.getElementById('edit-kep-bdn').value.trim();
            let kepBmmnInput = document.getElementById('edit-kep-bmmn').value.trim();

            // Tambahkan akhiran /KBC.1002/[TAHUN] jika yang diinput hanya angka
            if (kepBdnInput && !kepBdnInput.includes("/")) {
                kepBdnInput = `${kepBdnInput}/KBC.1002/${currentYear}`;
            }
            if (kepBmmnInput && !kepBmmnInput.includes("/")) {
                kepBmmnInput = `${kepBmmnInput}/KBC.1002/${currentYear}`;
            }

            // Paket data final yang siap dikirim
            const dataToSave = {
                "NO SBP": noSbp,
                "LOK PENYIMPANAN BHP": document.getElementById('edit-lokasi').value.trim(),
                "LHP": document.getElementById('edit-lhp').value.trim(),
                "KEP BDN": kepBdnInput,
                "KEP BMMN": kepBmmnInput,
                "STATUS": document.getElementById('edit-status-dropdown').value
            };

            // Ubah teks tombol menjadi loading
            const submitBtn = formEdit.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.innerHTML;
            submitBtn.innerHTML = "MENYIMPAN DATA...";
            submitBtn.disabled = true;

            // URL Web App GAS Anda
            const gasURL = "https://script.google.com/macros/s/AKfycbyD8mEHenV_O6tZeSSRS996g9E2nHeZbWQQ0VduDserie8LW_6IeUjXsLejTHc3ypFm/exec"; 

            // Kirim data ke Google Apps Script
            fetch(gasURL, {
                method: "POST",
                body: JSON.stringify(dataToSave)
            })
            .then(response => response.json())
            .then(result => {
                if(result.status === "success") {
                    alert("Berhasil! Data telah diupdate. Gudang akan dimuat ulang.");
                    editPopup.classList.add('hidden');
                    formEdit.reset();
                    
                    // Muat ulang data 3D gudang agar update terlihat langsung
                    enterWarehouse(); 
                } else {
                    alert("Gagal menyimpan: " + result.message);
                }
            })
            .catch(error => {
                console.error("Error:", error);
                alert("Terjadi kesalahan jaringan.");
            })
            .finally(() => {
                submitBtn.innerHTML = originalBtnText;
                submitBtn.disabled = false;
            });
        });

    </script>
</body>
