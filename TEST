        // --- SISTEM PEMBACAAN DATA BHP KARDUS ---
        function getBlockCoords(id, dynamicFloor2Y) {
            if(!id || id.length < 2) return null;
            let rowChar = id.charAt(0).toUpperCase();
            let colNum = parseInt(id.substring(1));
            
            let rCode = rowChar.charCodeAt(0);
            let yPos = 0, rowIndex = 0;
            
            if(rCode >= 65 && rCode <= 68) { 
                yPos = 0; rowIndex = rCode - 65;
            } else if (rCode >= 69 && rCode <= 72) { 
                yPos = dynamicFloor2Y; rowIndex = rCode - 69;
            } else return null; 
            
            let colIndex = colNum - 1;
            return { x: colIndex * 1.5 - 3.75, y: yPos, z: rowIndex * 1.5 - 2.25 };
        }

        let blockStackCount = {};
        let sbpColors = {};

        function renderBHP(dataArray) {
            globalBHPData = dataArray;
            kardusGroup.clear(); 
            blockStackCount = {};
            sbpColors = {}; 
            
            let floor1Counts = {};
            let maxF1Stack = 0;
            dataArray.forEach(item => {
                let lok = item["LOK PENYIMPANAN BHP"];
                if(!lok || lok === "-" || (item["STATUS"] && item["STATUS"].toLowerCase() === "sudah musnah")) return;
                
                let blocks = lok.split("-");
                blocks.forEach(b => {
                    let bId = b.trim();
                    if (['A','B','C','D'].includes(bId.charAt(0).toUpperCase())) {
                        let addAmount = (blocks.length > 1) ? 4 : 1;
                        floor1Counts[bId] = (floor1Counts[bId] || 0) + addAmount;
                        let sLevel = Math.floor((floor1Counts[bId] - 1) / 4);
                        if (sLevel > maxF1Stack) maxF1Stack = sLevel;
                    }
                });
            });

            let dynamicFloor2Y = Math.max(2.5, 0.3 + (maxF1Stack * 0.45) + 0.4 + 0.5);
            buildWarehouseEnvironment(dynamicFloor2Y);

            const kardusGeo = new THREE.BoxGeometry(0.6, 0.4, 0.6); 
            const neonColors = [0xff00ff, 0x00ffff, 0x00ff00, 0xffff00, 0xff0000, 0xffa500, 0x33ffb0];

            dataArray.forEach(item => {
                let lok = item["LOK PENYIMPANAN BHP"];
                if(!lok || lok === "-" || (item["STATUS"] && item["STATUS"].toLowerCase() === "sudah musnah")) return;
                
                let sbpStr = String(item["NO SBP"]);
                let rawDate = item["TGL SBP"];
                let cleanDate = rawDate;
                if (typeof rawDate === 'string' && rawDate.includes('T')) {
                    cleanDate = rawDate.split('T')[0];
                }
                // --- FORMAT TANGGAL DD-MM-YY (Letakkan di sini) ---
                let shortDate = cleanDate;
                if (cleanDate && cleanDate.includes('-')) {
                    let d = cleanDate.split('-'); // memecah [YYYY, MM, DD]
                    if (d.length === 3) {
                        shortDate = `${d[2]}-${d[1]}-${d[0].substring(2)}`; 
                    }
                }
                // --------------------------------------------------
                if (!sbpColors[sbpStr]) {
                    sbpColors[sbpStr] = neonColors[Math.floor(Math.random() * neonColors.length)];
                }
                let groupColor = sbpColors[sbpStr];
                
                let blocks = lok.split("-");
                blocks.forEach(blockID => {
                    blockID = blockID.trim();
                    let coords = getBlockCoords(blockID, dynamicFloor2Y);
                    
                    if (coords) {
                        let boxesToCreate = (blocks.length > 1) ? 4 : 1;

                        for(let b = 0; b < boxesToCreate; b++) {
                            if (!blockStackCount[blockID]) blockStackCount[blockID] = 0;
                            
                            const kardusMat = new THREE.MeshStandardMaterial({ color: 0xc19a6b });
                            const kardus = new THREE.Mesh(kardusGeo, kardusMat);
                            kardus.add(new THREE.LineSegments(new THREE.EdgesGeometry(kardusGeo), new THREE.LineBasicMaterial({ color: 0x000000 })));
                            
                            let count = blockStackCount[blockID];
                            let subIndex = count % 4; 
                            let stackLevel = Math.floor(count / 4); 

                            let offsetX = (subIndex % 2 === 0) ? -0.35 : 0.35;
                            let offsetZ = (subIndex < 2) ? -0.35 : 0.35;
                            let offsetY = coords.y + 0.1 + 0.2 + (stackLevel * 0.45);
                            
                            kardus.position.set(coords.x + offsetX, offsetY, coords.z + offsetZ);
                            
                            kardus.userData = {
                                isKardus: true,
                                noSBP: sbpStr,
                                fullData: item, 
                                isSearched: false,
                                tooltip: `SBP-${sbpStr} tgl ${shortDate}<br>(${item["LOK PENYIMPANAN BHP"]})`,
                                originalColor: 0xc19a6b,
                                hoverColor: groupColor, 
                                materialRef: kardusMat
                            };
                            
                            kardusGroup.add(kardus);
                            blockStackCount[blockID]++;
                        }
                    }
                });
            });
        }

        // --- RAYCASTING ---
        const raycaster = new THREE.Raycaster();
