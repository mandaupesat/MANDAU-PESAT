    <script type="module">
        import * as THREE from 'three';
        import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

        let globalBHPData = [];

        // --- FUNGSI DOWNLOAD QR ---
        window.downloadQRImage = function(qrUrl, labelText, noSbp, sbpYear) {
            const canvas = document.createElement('canvas');
            canvas.width = 300;
            canvas.height = 340; // Mengurangi tinggi canvas agar proporsional setelah teks SBP dihapus
            const ctx = canvas.getContext('2d');
            
            // Background Putih
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            
            // Border Garis Hitam Tebal
            ctx.strokeStyle = '#000000';
            ctx.lineWidth = 10;
            ctx.strokeRect(0, 0, canvas.width, canvas.height);
            
            const img = new Image();
            img.crossOrigin = 'Anonymous';
            img.src = qrUrl;
            img.onload = () => {
                        // Gambar QR diperbesar (posisi x:20, y:20, lebar:260, tinggi:260)
                        ctx.drawImage(img, 20, 20, 260, 260);
                        
                        // Tulis Label di bawah QR (posisi Y diturunkan menjadi 315)
                        ctx.fillStyle = '#000000';
                        ctx.font = 'bold 28px monospace';
                        ctx.textAlign = 'center';
                        ctx.fillText(labelText, 150, 315);
                
                // Teks SBP di bagian bawah dihapus sepenuhnya
                
                // Eksekusi Download
                const link = document.createElement('a');
                
                // Nama file unduhan dinamis menggunakan parameter 'sbpYear'
                const safeNoSbp = noSbp.replace(/\//g, '_');
                link.download = `SBP-${safeNoSbp}_${sbpYear}.png`; 
                
                link.href = canvas.toDataURL('image/png');
                link.click();
            };
            img.onerror = () => {
                alert('Gagal memuat gambar QR dari server API. Pastikan koneksi internet stabil.');
            };
        };
        // --- FUNGSI DOWNLOAD SEMUA QR (ZIP) ---
        window.downloadAllQRs = async function() {
            if (!globalBHPData || globalBHPData.length === 0) {
                alert("Data belum dimuat sepenuhnya. Harap tunggu.");
                return;
            }

            const btn = document.getElementById('btn-download-all');
            const originalText = btn.innerHTML;
            
            // Ubah tampilan tombol saat memproses
            btn.innerHTML = "⏳ MEMPROSES...";
            btn.disabled = true;
            btn.classList.replace('bg-blue-600', 'bg-gray-500');

            const zip = new JSZip();
            const qrFolder = zip.folder("QR_SIBHADAK");
            
            // Saring data untuk menghindari baris kosong
            const validItems = globalBHPData.filter(item => item["NO SBP"] && String(item["NO SBP"]).trim() !== "" && String(item["NO SBP"]).trim() !== "-");

            const promises = validItems.map(item => {
                return new Promise((resolve) => {
                    let rawDate = item["TGL SBP"] || "";
                    let cleanDate = rawDate;
                    if (typeof rawDate === 'string' && rawDate.includes('T')) {
                        cleanDate = rawDate.split('T')[0];
                    }
                 
                    let sbpYear = (cleanDate !== rawDate && cleanDate) ? cleanDate.split('-')[0] : "9999"; 
                    
                    const noSbp = String(item["NO SBP"]);
                    const safeNoSbp = noSbp.replace(/\//g, '_');
                    const fileName = `SBP-${safeNoSbp}_${sbpYear}.png`;
                    const labelText = item["LABEL"] || "-";

                    const baseWebUrl = window.location.origin + window.location.pathname;
                    const finalQrUrl = `https://quickchart.io/qr?size=200&text=${encodeURIComponent(baseWebUrl + "?sbp=" + noSbp)}`;

                    const canvas = document.createElement('canvas');
                    canvas.width = 300;
                    canvas.height = 340;
                    const ctx = canvas.getContext('2d');
                    
                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                    
                    ctx.strokeStyle = '#000000';
                    ctx.lineWidth = 10;
                    ctx.strokeRect(0, 0, canvas.width, canvas.height);
                    
                    const img = new Image();
                    img.crossOrigin = 'Anonymous';
                    img.src = finalQrUrl;
                    
                    img.onload = () => {
                        // Gambar QR diperbesar (posisi x:20, y:20, lebar:260, tinggi:260)
                        ctx.drawImage(img, 20, 20, 260, 260);
                        
                        // Tulis Label di bawah QR (posisi Y diturunkan menjadi 315)
