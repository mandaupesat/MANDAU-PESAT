    <!-- 2. SIMPAN KE CACHE STORAGE (Agar loading ke-2 dst secepat kilat) -->
    <script>
        (async function() {
            // Deteksi jenis perangkat pengguna
            const isMobile = window.innerWidth <= 768;
            const bgUrl = isMobile 
                ? 'https://i.ibb.co.com/7Jk6WNNb/bgportrait.jpg' 
                : 'https://i.ibb.co.com/jBN0hWd/bgsibadhak.jpg';
            
            try {
                // Membuka brankas memori bernama 'sibhadak-bg-cache'
                const cache = await caches.open('sibhadak-bg-cache');
                const cachedRes = await cache.match(bgUrl);
                
                if (cachedRes) {
                    // Jika gambar SUDAH ADA di memori browser, ubah jadi file lokal (Blob)
                    const blob = await cachedRes.blob();
                    const objectUrl = URL.createObjectURL(blob);
                    
                    // Suntikkan CSS khusus untuk menimpa URL online dengan file lokal yang instan
                    const style = document.createElement('style');
                    if (isMobile) {
                        style.innerHTML = `@media (max-width: 768px) { body { background-image: url('${objectUrl}') !important; } }`;
                    } else {
                        style.innerHTML = `body { background-image: url('${objectUrl}') !important; }`;
                    }
                    document.head.appendChild(style);
                } else {
                    // Jika BARU PERTAMA KALI buka, download gambar dan simpan ke brankas untuk besok
                    fetch(bgUrl).then(res => {
                        // Pastikan responsnya aman sebelum disimpan
                        if(res.ok || res.type === 'opaque') cache.put(bgUrl, res);
                    }).catch(err => console.log('Menyimpan background ke memori tertunda: ', err));
                }
            } catch (e) {
                // Jika browser jadul atau mode incognito super ketat memblokirnya, abaikan secara senyap
                console.warn('Sistem Cache browser dimatikan.');
            }
        })();
    </script>
    
